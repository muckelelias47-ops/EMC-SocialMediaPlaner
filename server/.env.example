# Copy this file to server/.env only for LOCAL configuration. Never commit secrets.
# Public HTTPS origin of this API service, without a path.
PUBLIC_BASE_URL=
# Current public frontend origin. Other GitHub repository paths share this origin.
FRONTEND_ORIGIN=https://muckelelias47-ops.github.io
PORT=8787
DATA_DIR=server/data
# Required: canonical base64 representation of exactly 32 random bytes.
# Set the value securely in the hosting provider's secret environment settings.
CHANNEL_ENCRYPTION_KEY=

# Each provider is independently disabled until its credentials are configured.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
